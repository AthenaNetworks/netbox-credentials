# Local settings for the helper scripts in devbox/. Copy to site.env (git-ignored) and fill in.

# SSH target that runs the dev NetBox instance, and the key to reach it.
DEV_SSH_HOST=root@netbox-dev.example.com
DEV_SSH_KEY=~/.ssh/id_ed25519

# For devbox/import-secrets.sh: the source NetBox (with netbox-secrets) as seen from the dev host.
SOURCE_URL=https://127.0.0.1
SOURCE_HOST_HEADER=netbox.example.com
SOURCE_CA_BUNDLE=/etc/nginx/ssl/netbox.crt
SOURCE_TOKEN_FILE=/root/.netbox_token
# Local path (on this workstation) of the netbox-secrets RSA private key. Streamed over ssh, never copied.
SECRETS_PRIVATE_KEY=~/netbox-secrets/userkey_private.pem
